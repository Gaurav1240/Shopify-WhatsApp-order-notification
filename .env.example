SHOPIFY_STORE_NAME=your_store_name.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_admin_api_access_token
SHOPIFY_API_VERSION=2025-01

# Optional: enables the support agent to check the store's real return
# policy / FAQs via Shopify's Storefront MCP instead of guessing.
# Typical shape: https://your_store_name.myshopify.com/api/mcp
STOREFRONT_MCP_URL=

WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_API_VERSION=v21.0

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

MONITOR_INTERVAL_SECONDS=300
ORDER_LOOKBACK_DAYS=14
MONITOR_STATE_PATH=monitor_state.json

CART_POLL_INTERVAL_SECONDS=900
CART_ABANDON_AFTER_HOURS=1
CART_LOOKBACK_HOURS=48
CART_NOTIFIED_PATH=abandoned_cart_notified.json

APPOINTMENT_HOURS_START=9
APPOINTMENT_HOURS_END=17
APPOINTMENT_SLOT_MINUTES=60
APPOINTMENT_DAYS_AHEAD=7
APPOINTMENTS_PATH=appointments.json

# Abandoned-cart discount policy: edit discount_policy.json directly to tune
# tiers/caps for your store. These two only need to change if you want the
# state file or policy file somewhere other than the project root.
DISCOUNT_POLICY_PATH=discount_policy.json
DISCOUNT_CODES_PATH=discount_codes.json

# Log of proactive messages any agent sent to a phone number, given to the
# support agent as context. Only needs to change if you want it elsewhere.
NOTIFICATION_LOG_PATH=notification_log.json

# MCP server (mcp_server.py) — exposes every tool in tools.py, including
# cancel_order/refund_order/request_return, to an external system over
# Streamable HTTP. MCP_BEARER_TOKEN is required; generate a long random
# value (e.g. `openssl rand -hex 32`) and give it only to the system you're
# plugging in. Without it set, the server refuses every request (503).
MCP_BEARER_TOKEN=
MCP_HOST=0.0.0.0
MCP_PORT=8000
